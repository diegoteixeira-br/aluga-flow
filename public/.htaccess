# SPA fallback para Apache (Hostinger / cPanel).
# Garante que rotas client-side (ex.: /dashboard, /anuncios/123) sejam
# entregues como index.html, permitindo o TanStack Router assumir o roteamento.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) Se existir um arquivo pré-renderizado <path>.html (gerado por
  #    scripts/prerender-og.mjs para /blog/<slug> e /anuncios/<id>),
  #    servi-lo direto. Assim crawlers de redes sociais recebem já no
  #    primeiro request o HTML com as tags og:image/og:title corretas.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # 2) Não reescrever arquivos/diretórios reais (assets, /api, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3) Tudo o mais cai no SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Cache longo para assets versionados do Vite
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|png|jpg|jpeg|gif|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
